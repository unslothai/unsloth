{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/test",
      "!**/._*",
      "!**/.DS_Store",
      "!**/tsconfig*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "qwik": "none",
      "react": "all",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "turborepo": "none",
      "vue": "none"
    },
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "all" },
      "complexity": { "preset": "all" },
      "correctness": {
        "preset": "all",
        "useImportExtensions": "off",
        "noUnresolvedImports": "off"
      },
      "performance": { "preset": "all" },
      "security": { "preset": "all" },
      "style": {
        "preset": "all",
        "useNamingConvention": {
          "level": "on",
          "options": { "strictCase": false }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "Import from feature index only: @/features/[name]"
              },
              {
                "group": ["../features/*/**"],
                "message": "Use absolute imports: @/features/[name]"
              }
            ]
          }
        },
        "useComponentExportOnlyModules": {
          "level": "warn",
          "options": { "allowConstantExport": true }
        }
      },
      "suspicious": { "preset": "all", "noReactSpecificProps": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "suspicious": { "noConsole": "off" },
          "performance": { "useTopLevelRegex": "off" }
        }
      }
    },
    {
      "includes": ["**/vite.config.ts", "**/eslint.config.js"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/assistant-ui/reasoning.tsx"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/assistant-ui/attachment.tsx"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/assistant-ui/tool-fallback.tsx"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/component-example.tsx"],
      "linter": {
        "rules": {
          "performance": { "noNamespaceImport": "off" }
        }
      }
    },
    {
      "includes": ["**/src/config/env.ts"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/layout/index.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" }
        }
      }
    },
    {
      "includes": ["**/src/features/**/index.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" }
        }
      }
    },
    {
      "includes": ["**/src/features/chat/thread-sidebar.tsx"],
      "linter": {
        "rules": {
          "a11y": { "useSemanticElements": "off" }
        }
      }
    },
    {
      "includes": ["**/src/features/chat/runtime-provider.tsx"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/assistant-ui/thread.tsx"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": [
        "**/smoke-code-block-flicker-main.tsx",
        "**/smoke-find-in-page-main.tsx",
        "**/smoke-link-definition-probe-main.tsx",
        "**/smoke-reasoning-transcript-main.tsx",
        "**/smoke-research-main.tsx",
        "**/smoke-research-review-main.tsx",
        "**/smoke-shortcuts-main.tsx",
        "**/smoke-stream-pacing-main.tsx",
        "**/tests/fixtures/mtp-download/main.tsx"
      ],
      "linter": {
        "rules": {
          "style": { "noRestrictedImports": "off" }
        }
      }
    },
    {
      "includes": ["**/src/components/ui/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": { "organizeImports": "off" }
        }
      }
    }
  ]
}

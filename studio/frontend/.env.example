# Rag Platform backend transport. These values are non-secret.
VITE_RAG_PLATFORM_BASE_URL=
VITE_RAG_PLATFORM_API_PREFIX=/api/v1
VITE_RAG_PLATFORM_PROXY_TARGET=http://127.0.0.1

# Keep the existing Studio backend and Rag Platform backend as separate clients
# during migration. Do not put bearer tokens, passwords or provider keys here.
VITE_BACKEND_MODE=hybrid
VITE_RAG_PLATFORM_ENABLED=true

# Native Rag Platform auth. The public key is not a secret, but it must be the
# public half of the private key mounted in the active backend container.
# Prefer one base64 line in CI/build environments:
#   docker exec rag-platform-backend cat /ragflow/conf/public.pem | base64 | tr -d '\n'
VITE_RAG_PLATFORM_AUTH_ENABLED=true
VITE_RAG_PLATFORM_AUTH_PUBLIC_KEY_B64=

# Rollout controls may hide a capability only when deployment policy disables
# it. Runtime /system/config and /auth/login/channels are still authoritative.
VITE_RAG_PLATFORM_REGISTRATION_ENABLED=true
VITE_RAG_PLATFORM_PASSWORD_RECOVERY_ENABLED=true
VITE_RAG_PLATFORM_OAUTH_ENABLED=true
VITE_RAG_PLATFORM_MODEL_TOOLS_ENABLED=true

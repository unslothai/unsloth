+/// Attaches the dispatcher-selected ProcessContainer tier to the live handle.
+/// Keeping this wrapper outside the DACL guard preserves the guard's
+/// child-before-ACL-restoration drop ordering.
+struct TieredProcess {
+    process: Box<dyn SandboxProcess>,
+    tier: IsolationTier,
+}
+
+impl SandboxProcess for TieredProcess {
+    fn isolation_tier(&self) -> Option<&'static str> {
+        Some(self.tier.as_str())
+    }
+
+    fn warnings(&self) -> Vec<String> {
+        self.process.warnings()
+    }
+
+    fn output_metadata(&self) -> Option<&wxc_common::models::SandboxOutputMetadata> {
+        self.process.output_metadata()
+    }
+
+    fn take_stdin(&mut self) -> Option<Box<dyn std::io::Write + Send>> {
+        self.process.take_stdin()
+    }
+
+    fn take_stdout(&mut self) -> Option<Box<dyn std::io::Read + Send>> {
+        self.process.take_stdout()
+    }
+
+    fn take_stderr(&mut self) -> Option<Box<dyn std::io::Read + Send>> {
+        self.process.take_stderr()
+    }
+
+    fn try_wait(&mut self) -> std::io::Result<Option<i32>> {
+        self.process.try_wait()
+    }
+
+    fn id(&self) -> u32 {
+        self.process.id()
+    }
+
+    fn kill(&mut self) -> std::io::Result<()> {
+        self.process.kill()
+    }
+
+    fn wait(&mut self) -> std::io::Result<i32> {
+        self.process.wait()
+    }
+
+    fn stdout_closer(&self) -> Option<Box<dyn wxc_common::sandbox_process::StreamCloser>> {
+        self.process.stdout_closer()
+    }
+
+    fn stderr_closer(&self) -> Option<Box<dyn wxc_common::sandbox_process::StreamCloser>> {
+        self.process.stderr_closer()
+    }
+}

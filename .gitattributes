  it('should move legacy snapshot-path configs', () => {
    expect(adoptLegacyConfigKey({ legacyConfig: { snapshotPath: 'path' } })).toEqual({
      legacyConfig: { snapshotPath: 'path' },
    });
  });

  it('should preserve current-id overrides', () => {
    expect(adoptLegacyConfigKey({ legacyConfig: { currentId: 'id' } })).toEqual({
      legacyConfig: { currentId: 'id' },
    });
  });

  it('should avoid entry/byte-budget eviction during adoption', () => {

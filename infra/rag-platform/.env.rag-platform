####################################################################
# Rag Platform — owned deployment env layer
#
# This file is the OWNED override layer on top of the upstream
# backend env file (<backend>/docker/.env). It is applied *after* the
# upstream file, so every key here wins (Docker Compose env_file and
# --env-file are both later-wins; verified with `docker compose config`).
#
# Rules this file obeys (see docs/adr/0000-rag-platform-branding-and-white-label.md):
#   * No secrets. Credentials stay in the upstream backend env file,
#     which is not part of this repository.
#   * Upstream environment variable NAMES are never renamed. Only
#     values that name an owned artifact are overridden here.
#   * Container-internal paths, imports and package names are untouched.
####################################################################

# ---------------------------------------------------------------
# Compose identity (owned)
# ---------------------------------------------------------------
# Docker Compose project name. Objects are created as
# rag-platform-<service> / rag-platform_<network|volume> unless an
# explicit `name:` is set in the compose file.
COMPOSE_PROJECT_NAME=rag-platform

# Active profiles. Upstream computes COMPOSE_PROFILES as
# "${DOC_ENGINE},${DEVICE}" (= "elasticsearch,cpu"), which would start the
# upstream `ragflow-cpu` service. The owned services live behind the
# `platform-cpu` / `platform-gpu` profiles instead, so the upstream backend
# services stay inactive. `ragflow-go` activates the upstream NATS dependency
# required by the pinned Go API/admin and ingestor configuration.
#
# GPU host: COMPOSE_PROFILES=elasticsearch,ragflow-go,platform-gpu
# Never enable platform-cpu and platform-gpu together — both bind the
# container name rag-platform-backend and Compose rejects the pair at
# config time. That collision IS the required CPU/GPU profile validation.
COMPOSE_PROFILES=elasticsearch,ragflow-go,platform-cpu

# ---------------------------------------------------------------
# Backend proxy scheme (owned value: hybrid — see ADR 0005)
# ---------------------------------------------------------------
# docker/entrypoint.sh selects the in-container nginx config AND gates
# which processes start at all:
#   python -> nginx ragflow.conf.python, Python API 9380 + Python admin 9381
#   go     -> nginx ragflow.conf.golang, Go API 9384 + Go admin 9383
#   hybrid -> nginx ragflow.conf.hybrid, all four of the above
#
# The published v0.26.4 image omits bin/ragflow_server. Faz 0 supplies the
# missing executable in the owned image alias using
# Dockerfile.backend-with-go + build-backend-image.sh. The binary is compiled
# from the exact v0.26.4 tag commit and copied over the otherwise-unmodified
# upstream runtime image. With that owned layer present, entrypoint.sh can start
# Python API/admin and Go API/admin together and the hybrid nginx map is valid.
API_PROXY_SCHEME=hybrid

# ---------------------------------------------------------------
# Owned database / object-store naming (fresh installs only)
# ---------------------------------------------------------------
# MySQL schema. Requires the owned bootstrap script
# rag-platform-config/init.sql, which is bind-mounted over the base
# compose file's /data/application/init.sql. The application only
# creates TABLES (api.db.db_models.init_database_tables); the DATABASE
# itself is created solely by that mysql --init-file script.
# Do not change this on an installation that already holds data.
MYSQL_DBNAME=rag_platform

# MinIO root user / access key for a fresh installation.
MINIO_USER=rag_platform

# Single-bucket mode plus an owned key prefix. The bucket name stays
# DNS-safe (no underscore) so the same layout works against S3, OSS and
# GCS backends later; the key prefix uses the rag_platform form.
# Objects land at: rag-platform/rag_platform/<kb-id>/<file>
# (rag/utils/minio_conn.py use_default_bucket + use_prefix_path).
# In single-bucket mode the application never creates the bucket
# (health() only calls bucket_exists, put() skips make_bucket), so the
# owned platform-storage-init service creates it before the backend starts.
MINIO_BUCKET=rag-platform
MINIO_PREFIX_PATH=rag_platform

# ---------------------------------------------------------------
# Host sizing
# ---------------------------------------------------------------
# Per-container memory cap shared by the search/DB services. Upstream
# ships ~8 GiB, which sizes the Elasticsearch heap at ~4 GiB and is too
# large when the whole stack shares an 8 GiB host.
MEM_LIMIT=4294967296

# ---------------------------------------------------------------
# Backend checkout location
# ---------------------------------------------------------------
# Defaults to a sibling checkout (../../../rag-backend relative to this
# directory). Export RAG_PLATFORM_BACKEND_DIR to override; the
# platform-compose.sh wrapper validates that the path really is a
# backend checkout before invoking Compose.
# RAG_PLATFORM_BACKEND_DIR=/absolute/path/to/rag-backend

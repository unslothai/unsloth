# syntax=docker/dockerfile:1.7

# Build the Go server from the protected backend-authority commit materialized
# by the wrapper script. Native document parsing remains in the Python service;
# the Go control plane is intentionally pure-Go.
FROM --platform=$BUILDPLATFORM golang:1.26.4-bookworm AS go-builder

ARG TARGETOS
ARG TARGETARCH

ENV GOPROXY="https://proxy.golang.org,direct"

WORKDIR /src
COPY . .
COPY --from=rag-platform-assets pdf-oxide-adapter-nocgo.go \
  /src/internal/deepdoc/parser/pdf/pdfoxide/pdf_oxide_adapter_nocgo.go
COPY --from=rag-platform-assets rag-analyzer-nocgo.go \
  /src/internal/binding/rag_analyzer_nocgo.go
COPY --from=rag-platform-assets rag-analyzer-nocgo_test.go \
  /src/internal/binding/rag_analyzer_nocgo_owned_test.go

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/go-tmp \
    CGO_ENABLED=0 go test ./internal/binding \
    && CGO_ENABLED=0 GOMEMLIMIT=1500MiB GOTMPDIR=/root/.cache/go-tmp \
      go test -vet=off -p=1 \
      ./internal/admin ./internal/engine/nats ./internal/handler ./internal/service \
      -run '^(TestShutdownIngestor|TestIngestorControl|TestAuthMiddleware|TestBetaAuthMiddleware|TestGetTenantDetail|TestUpdateTenant|TestTenantManagement)' \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
      GOMEMLIMIT=1500MiB GOTMPDIR=/root/.cache/go-tmp \
      go build -p=1 -trimpath -ldflags="-s -w" \
      -o /src/bin/ragflow_server cmd/ragflow_server.go \
    && test -x /src/bin/ragflow_server

# Preserve every upstream runtime layer. Add the executable the upstream
# Dockerfile's `COPY bin bin` intended to ship and the runtime key wrapper.
FROM --platform=linux/amd64 infiniflow/ragflow:v0.26.4

ARG RAG_PLATFORM_FRONTEND_COMMIT="unknown"
ARG RAG_PLATFORM_BACKEND_COMMIT="unknown"

COPY --from=go-builder /src/bin/ragflow_server /ragflow/bin/ragflow_server
COPY --from=go-builder /src/api/db/services/file_commit_service.py \
  /ragflow/api/db/services/file_commit_service.py
COPY --from=go-builder /src/api/apps/restful_apis/aimlapi_api.py \
  /ragflow/api/apps/restful_apis/aimlapi_api.py
COPY --from=go-builder /src/common/aimlapi_utils.py \
  /ragflow/common/aimlapi_utils.py
COPY --from=rag-platform-assets backend-entrypoint.sh /usr/local/bin/rag-platform-entrypoint
COPY --from=rag-platform-assets runtime-readiness.sh /usr/local/bin/rag-platform-readiness
COPY --from=rag-platform-assets proxy.conf /etc/nginx/proxy.conf
COPY --from=rag-platform-assets security-headers.conf /etc/nginx/security-headers.conf

# Serve the owned frontend from the same nginx origin as /api/v1. Removing the
# inherited bundle first prevents stale upstream chunks from surviving a hash
# or filename change.
RUN rm -rf /ragflow/web/dist
COPY --from=rag-platform-frontend-dist . /ragflow/web/dist

RUN rm -f /ragflow/conf/private.pem /ragflow/conf/public.pem \
    && chmod 0755 /usr/local/bin/rag-platform-entrypoint /usr/local/bin/rag-platform-readiness \
    && test -s /ragflow/web/dist/index.html

ENTRYPOINT ["/usr/local/bin/rag-platform-entrypoint"]

LABEL org.opencontainers.image.title="Rag Platform backend" \
      org.opencontainers.image.version="0.26.4-phase15" \
      org.opencontainers.image.base.name="infiniflow/ragflow:v0.26.4" \
      org.opencontainers.image.revision="${RAG_PLATFORM_BACKEND_COMMIT}" \
      io.rag-platform.frontend.revision="${RAG_PLATFORM_FRONTEND_COMMIT}" \
      io.rag-platform.go-profile="pure-go" \
      io.rag-platform.release-profile="phase15-hardened-same-origin"
